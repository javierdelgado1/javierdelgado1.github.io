# Credenciales FTP del hosting cPanel. Copia este archivo a .env (no se versiona).
USERNAME=xzxxxxxx@ccxxx.com
SERVERFTP=ftp.xxxxxx.com.ve
PORT=21
PASSWORD=Xxxxxx

# Carpeta remota donde se publica dist/ (ruta desde la raíz del FTP).
# La cuenta FTP actual ya apunta al document root de https://blog.javierdelgado.com.ve/
# (comprobado subiendo un archivo de prueba), por eso es "/".
#   Si usaras la cuenta FTP principal de cPanel: REMOTE_DIR=/blog.javierdelgado.com.ve (la "Document Root"
#   del subdominio que muestre cPanel) o REMOTE_DIR=/public_html/blog para una subcarpeta.
# Debe coincidir con "baseUrl" de site.config.json (el basePath de cada idioma se define en "languages[]").
REMOTE_DIR=/

# Conexión cifrada: explicit (FTPS, recomendado si el hosting lo soporta) | implicit | off
FTP_SECURE=off
# Pon 1 si el certificado del hosting no coincide con el nombre del servidor FTP
FTP_INSECURE_TLS=0
